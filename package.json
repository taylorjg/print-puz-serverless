{
  "name": "print-puz-serverless",
  "version": "0.0.19",
  "description": "Serverless backend for print-puz-react-vite",
  "main": "index.js",
  "scripts": {
    "deploy": "SLS_AWS_SDK=3 serverless deploy",
    "info": "SLS_AWS_SDK=3 serverless info",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "invoke:local": "bash scripts/invoke-all-local.sh",
    "invoke:deployed": "bash scripts/invoke-all-deployed.sh",
    "invoke:curl": "bash scripts/curl-all.sh",
    "check": "npm run lint && npm test && npm run invoke:local"
  },
  "author": "Jonathan Taylor",
  "license": "MIT",
  "dependencies": {
    "@confuzzle/readpuz": "^1.2.3",
    "axios": "^1.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "serverless": "^4.41.0",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "serverless@4.40.0": true
  }
}
